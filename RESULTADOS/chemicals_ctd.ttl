    <https://schema.org/identifier> "D008779" .

<https://id.nlm.nih.gov/mesh/D008784>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Methysergide" ;
