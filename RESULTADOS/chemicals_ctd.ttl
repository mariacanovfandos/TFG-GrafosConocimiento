    <https://schema.org/identifier> "D003999" .

<https://id.nlm.nih.gov/mesh/D004002>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Clodronic Acid" ;
