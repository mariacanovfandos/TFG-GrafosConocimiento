    <http://www.w3.org/2000/01/rdf-schema#label> "Methylnitronitrosoguanidine" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/VZUNGTLZRAYYDE-UHFFFAOYSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A nitrosoguanidine derivative with potent mutagenic and carcinogenic properties." ;
    <https://schema.org/identifier> "D008769" .

<https://id.nlm.nih.gov/mesh/D008770>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Methylnitrosourea" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/ZRKWMRDKSOPRRS-UHFFFAOYSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A nitrosourea compound with alkylating, carcinogenic, and mutagenic properties." ;
    <https://schema.org/identifier> "D008770" .

