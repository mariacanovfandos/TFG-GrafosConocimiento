    <http://www.w3.org/2000/01/rdf-schema#label> "Tremorine" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/JSUAJTLKVREZHV-UHFFFAOYSA-N> ;
    <https://schema.org/identifier> "D014203" .

<https://id.nlm.nih.gov/mesh/D014212>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Tretinoin" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/SHGAZHPCJJPHSC-YCNIQYBTSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "An important regulator of GENE EXPRESSION during growth and development, and in NEOPLASMS. Tretinoin, also known as retinoic acid and derived from maternal VITAMIN A, is essential for normal GROWTH; and EMBRYONIC DEVELOPMENT. An excess of tretinoin can be teratogenic. It is used in the treatment of PSORIASIS; ACNE VULGARIS; and several other SKIN DISEASES. It has also been approved for use in promyelocytic leukemia (LEUKEMIA, PROMYELOCYTIC, ACUTE)." ;
    <https://schema.org/identifier> "D014212" .

<https://id.nlm.nih.gov/mesh/D014213>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Tretoquinol" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/RGVPOXRFEPSFGH-AWEZNQCLSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "An adrenergic beta-agonist used as a bronchodilator agent in asthma therapy." ;
    <https://schema.org/identifier> "D014213" .

<https://id.nlm.nih.gov/mesh/D014214>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Triallate" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/MWBPRDONLNQCFV-UHFFFAOYSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A pre-emergence, selective herbicide for the control of wild oats in various crops." ;
    <https://schema.org/identifier> "D014214" .

<https://id.nlm.nih.gov/mesh/D014215>
