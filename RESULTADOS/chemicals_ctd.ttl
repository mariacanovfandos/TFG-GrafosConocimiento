    <http://www.w3.org/2004/02/skos/core#definition> "A dye that has been used as an industrial dye, a laboratory indicator, and a biological stain." ;
    <https://schema.org/identifier> "D001978" .

<https://id.nlm.nih.gov/mesh/D001979>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Bromthymol Blue" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/NUHCTOLBWMJMLX-UHFFFAOYSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A pH sensitive dye that has been used as an indicator in many laboratory reactions." ;
    <https://schema.org/identifier> "D001979" .

<https://id.nlm.nih.gov/mesh/D002019>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Bufexamac" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/MXJWRABVEGLYDG-UHFFFAOYSA-N> ;
