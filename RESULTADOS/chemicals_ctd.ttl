    <http://www.w3.org/2004/02/skos/core#definition> "A sedative and mild hypnotic with potentially toxic effects." ;
    <https://schema.org/identifier> "D001968" .

<https://id.nlm.nih.gov/mesh/D001971>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Bromocriptine" ;
