    <https://schema.org/identifier> "D002981" .

<https://id.nlm.nih.gov/mesh/D002990>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Clobetasol" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/FCSHDIVRCWTZOX-DVTGEIKXSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A derivative of PREDNISOLONE with high glucocorticoid activity and low mineralocorticoid activity. Absorbed through the skin faster than FLUOCINONIDE, it is used topically in treatment of PSORIASIS but may cause marked adrenocortical suppression." ;
    <https://schema.org/identifier> "D002990" .

<https://id.nlm.nih.gov/mesh/D002991>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Clofazimine" ;
