    <https://schema.org/identifier> "D017693" .

<https://id.nlm.nih.gov/mesh/D017706>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Lisinopril" ;
