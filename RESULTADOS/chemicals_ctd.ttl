    <http://www.w3.org/2004/02/skos/core#definition> "A pyrrolidinylmethyl TETRACYCLINE." ;
    <https://schema.org/identifier> "D012382" .

<https://id.nlm.nih.gov/mesh/D012402>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Rotenone" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/JUVIOZPCNVVQFO-HBGVWJBISA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A botanical insecticide that is an inhibitor of mitochondrial electron transport." ;
    <https://schema.org/identifier> "D012402" .

<https://id.nlm.nih.gov/mesh/D012406>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Roxarsone" ;
