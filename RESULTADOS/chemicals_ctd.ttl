    <http://www.w3.org/2004/02/skos/core#definition> "A piperazine derivative having histamine H1-receptor and calcium-channel blocking activity with vasodilating and antiemetic properties but it induces PARKINSONIAN DISORDERS." ;
    <https://schema.org/identifier> "D002936" .

<https://id.nlm.nih.gov/mesh/D002937>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Cinoxacin" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/VDUWPHTZYNWKRN-UHFFFAOYSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Synthetic antimicrobial related to OXOLINIC ACID and NALIDIXIC ACID and used in URINARY TRACT INFECTIONS." ;
    <https://schema.org/identifier> "D002937" .

<https://id.nlm.nih.gov/mesh/D002939>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Ciprofloxacin" ;
