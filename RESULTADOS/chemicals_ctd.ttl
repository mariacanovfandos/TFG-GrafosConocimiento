    <http://www.w3.org/2004/02/skos/core#definition> "A dopamine D2 antagonist that is used as an antiemetic." ;
    <https://schema.org/identifier> "D008787" .

<https://id.nlm.nih.gov/mesh/D008788>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Metolazone" ;
