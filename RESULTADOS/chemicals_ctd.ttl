    <http://www.w3.org/2004/02/skos/core#definition> "Insecticide, molluscacide, acaricide." ;
    <https://schema.org/identifier> "D008714" .

<https://id.nlm.nih.gov/mesh/D008715>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Methionine" ;
