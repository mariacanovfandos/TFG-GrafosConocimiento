    <https://schema.org/identifier> "D001962" .

<https://id.nlm.nih.gov/mesh/D001964>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Bromhexine" ;
