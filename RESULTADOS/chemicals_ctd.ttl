    <http://www.w3.org/2004/02/skos/core#definition> "A serotonin uptake inhibitor that is effective in the treatment of depression." ;
    <https://schema.org/identifier> "D017374" .

<https://id.nlm.nih.gov/mesh/D017378>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Quinolinic Acid" ;
