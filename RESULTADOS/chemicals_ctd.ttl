    <http://www.w3.org/2004/02/skos/core#definition> "An intravenous anesthetic with a short duration of action that may be used for induction of anesthesia." ;
    <https://schema.org/identifier> "D008723" .

<https://id.nlm.nih.gov/mesh/D008724>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Methomyl" ;
