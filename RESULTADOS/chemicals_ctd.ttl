    <http://www.w3.org/2000/01/rdf-schema#label> "Letrozole" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/HPJKCIUCZWXJDR-UHFFFAOYSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A triazole and benzonitrile derivative that is a selective non-steroidal aromatase inhibitor, similar to ANASTROZOLE. It is used in the treatment of metastatic or locally advanced breast cancer in postmenopausal women." ;
    <https://schema.org/identifier> "D000077289" .

<https://id.nlm.nih.gov/mesh/D000077291>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Terbinafine" ;
