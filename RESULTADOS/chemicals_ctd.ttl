    <http://www.w3.org/2004/02/skos/core#definition> "A synthetic steroid that has been used for its anabolic action." ;
    <https://schema.org/identifier> "D008710" .

<https://id.nlm.nih.gov/mesh/D008711>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Metergoline" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/WZHJKEUHNJHDLS-QTGUNEKASA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A dopamine agonist and serotonin antagonist. It has been used similarly to BROMOCRIPTINE as a dopamine agonist and also for MIGRAINE DISORDERS therapy." ;
    <https://schema.org/identifier> "D008711" .

<https://id.nlm.nih.gov/mesh/D008712>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Methicillin" ;
