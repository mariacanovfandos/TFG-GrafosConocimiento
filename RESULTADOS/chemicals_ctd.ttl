    <http://www.w3.org/2000/01/rdf-schema#label> "alpha-Linolenic Acid" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/DTOSIQBPPRVQHS-PDBXOOCHSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A fatty acid that is found in plants and involved in the formation of prostaglandins." ;
    <https://schema.org/identifier> "D017962" .

<https://id.nlm.nih.gov/mesh/D017963>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Azithromycin" ;
