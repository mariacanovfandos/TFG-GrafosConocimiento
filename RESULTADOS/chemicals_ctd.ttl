    <https://schema.org/identifier> "D008742" .

<https://id.nlm.nih.gov/mesh/D008743>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Methyl Parathion" ;
