    <http://www.w3.org/2004/02/skos/core#definition> "An arsenic derivative which has anticoccidial action and promotes growth in animals." ;
    <https://schema.org/identifier> "D012406" .

<https://id.nlm.nih.gov/mesh/D012413>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Rubidium" ;
