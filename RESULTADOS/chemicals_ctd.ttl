    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Methylprednisolone Hemisuccinate" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/IMBXEJJVJRTNOW-XYMSELFBSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A water-soluble ester of METHYLPREDNISOLONE used for cardiac, allergic, and hypoxic emergencies." ;
    <https://schema.org/identifier> "D008776" .

<https://id.nlm.nih.gov/mesh/D008777>
