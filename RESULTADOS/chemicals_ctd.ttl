    <http://www.w3.org/2004/02/skos/core#definition> "Radiopaque medium used as diagnostic aid." ;
    <https://schema.org/identifier> "D007480" .

<https://id.nlm.nih.gov/mesh/D007482>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Iothalamate Meglumine" ;
