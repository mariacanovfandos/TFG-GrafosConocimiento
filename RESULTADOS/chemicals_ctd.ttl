    <http://www.w3.org/2004/02/skos/core#definition> "A carbonic anhydrase inhibitor that is used as a diuretic and in the treatment of glaucoma." ;
    <https://schema.org/identifier> "D008704" .

<https://id.nlm.nih.gov/mesh/D008709>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Methenamine" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/VKYKSIONXSXAKP-UHFFFAOYSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "An anti-infective agent most commonly used in the treatment of urinary tract infections. Its anti-infective action derives from the slow release of formaldehyde by hydrolysis at acidic pH. (From Martindale, The Extra Pharmacopoeia, 30th ed, p173)" ;
    <https://schema.org/identifier> "D008709" .

<https://id.nlm.nih.gov/mesh/D008710>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Methenolone" ;
