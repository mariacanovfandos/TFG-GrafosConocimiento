    <http://www.w3.org/2004/02/skos/core#definition> "An oral hypolipemic agent primarily used in DOGS and RATS." ;
    <https://schema.org/identifier> "D002992" .

<https://id.nlm.nih.gov/mesh/D002994>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Clofibrate" ;
