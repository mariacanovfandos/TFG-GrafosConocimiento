    <http://www.w3.org/2000/01/rdf-schema#label> "Dibutyl Phthalate" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/DOIRQSBPFJWKBE-UHFFFAOYSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A plasticizer used in most plastics and found in water, air, soil, plants and animals. It may have some adverse effects with long-term exposure." ;
    <https://schema.org/identifier> "D003993" .

<https://id.nlm.nih.gov/mesh/D003994>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Bucladesine" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/CJGYSWNGNKCJSB-YVLZZHOMSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A cyclic nucleotide derivative that mimics the action of endogenous CYCLIC AMP and is capable of permeating the cell membrane. It has vasodilator properties and is used as a cardiac stimulant. (From Merck Index, 11th ed)" ;
    <https://schema.org/identifier> "D003994" .

