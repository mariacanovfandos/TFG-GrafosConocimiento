    <http://www.w3.org/2000/01/rdf-schema#label> "Methoxyhydroxyphenylglycol" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/FBWPWWWZWKPJFL-UHFFFAOYSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Synthesized from endogenous epinephrine and norepinephrine in vivo. It is found in brain, blood, CSF, and urine, where its concentrations are used to measure catecholamine turnover." ;
    <https://schema.org/identifier> "D008734" .

<https://id.nlm.nih.gov/mesh/D008735>
    a <http://semanticscience.org/resource/SIO_010004> ;
