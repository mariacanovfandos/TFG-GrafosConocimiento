    <http://www.w3.org/2004/02/skos/core#definition> "Halogenated anti-infective agent that is used against trematode and cestode infestations." ;
    <https://schema.org/identifier> "D001735" .

<https://id.nlm.nih.gov/mesh/D001865>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Bongkrekic Acid" ;
