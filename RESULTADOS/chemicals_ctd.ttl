    <http://www.w3.org/2004/02/skos/core#definition> "A sulfanilamide antibacterial agent." ;
    <https://schema.org/identifier> "D013423" .

<https://id.nlm.nih.gov/mesh/D013426>
    a <http://semanticscience.org/resource/SIO_010004> ;
