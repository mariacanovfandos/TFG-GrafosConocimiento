    <http://www.w3.org/2004/02/skos/core#definition> "A carbamate insecticide with anticholinesterase activity." ;
    <https://schema.org/identifier> "D008724" .

<https://id.nlm.nih.gov/mesh/D008726>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Methoprene" ;
