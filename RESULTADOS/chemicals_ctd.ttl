    <http://www.w3.org/2000/01/rdf-schema#label> "Cladribine" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/PTOAARAWEBMLNO-KVQBGUIXSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "An antineoplastic agent used in the treatment of lymphoproliferative diseases including hairy-cell leukemia." ;
    <https://schema.org/identifier> "D017338" .

<https://id.nlm.nih.gov/mesh/D017341>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Etanidazole" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/WCDWBPCFGJXFJZ-UHFFFAOYSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A nitroimidazole that sensitizes hypoxic tumor cells that are normally resistant to radiation therapy." ;
    <https://schema.org/identifier> "D017341" .

<https://id.nlm.nih.gov/mesh/D017371>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "8-Hydroxy-2-(di-n-propylamino)tetralin" ;
