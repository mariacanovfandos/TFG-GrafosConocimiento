    <https://schema.org/identifier> "D006830" .

<https://id.nlm.nih.gov/mesh/D006851>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Hydrochloric Acid" ;
