    <http://www.w3.org/2004/02/skos/core#definition> "A serotonin 1A-receptor agonist that is used experimentally to test the effects of serotonin." ;
    <https://schema.org/identifier> "D017371" .

<https://id.nlm.nih.gov/mesh/D017373>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Cyproterone Acetate" ;
