    <https://schema.org/identifier> "D008719" .

<https://id.nlm.nih.gov/mesh/D008721>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Methocarbamol" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/GNXFOGHNGIVQEH-UHFFFAOYSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A centrally acting muscle relaxant whose mode of action has not been established. It is used as an adjunct in the symptomatic treatment of musculoskeletal conditions associated with painful muscle spasm. (From Martindale, The Extra Pharmacopoeia, 30th ed, p1206)" ;
    <https://schema.org/identifier> "D008721" .

<https://id.nlm.nih.gov/mesh/D008723>
    a <http://semanticscience.org/resource/SIO_010004> ;
