    <http://www.w3.org/2004/02/skos/core#definition> "A sulfonilamide anti-infective agent." ;
    <https://schema.org/identifier> "D013426" .

<https://id.nlm.nih.gov/mesh/D013427>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Sulfapyridine" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/GECHUMIMRBOMGK-UHFFFAOYSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Antibacterial, potentially toxic, used to treat certain skin diseases." ;
    <https://schema.org/identifier> "D013427" .

<https://id.nlm.nih.gov/mesh/D013442>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Sulfinpyrazone" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/MBGGBVCUIVRRBF-UHFFFAOYSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A uricosuric drug that is used to reduce the serum urate levels in gout therapy. It lacks anti-inflammatory, analgesic, and diuretic properties." ;
    <https://schema.org/identifier> "D013442" .

<https://id.nlm.nih.gov/mesh/D013443>
