    <http://www.w3.org/2004/02/skos/core#definition> "An anticoccidial agent mainly for poultry." ;
    <https://schema.org/identifier> "D012370" .

<https://id.nlm.nih.gov/mesh/D012382>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Rolitetracycline" ;
