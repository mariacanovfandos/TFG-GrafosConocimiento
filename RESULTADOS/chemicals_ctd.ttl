    <http://www.w3.org/2004/02/skos/core#definition> "A metabolite of tryptophan with a possible role in neurodegenerative disorders. Elevated CSF levels of quinolinic acid are correlated with the severity of neuropsychological deficits in patients who have AIDS." ;
    <https://schema.org/identifier> "D017378" .

<https://id.nlm.nih.gov/mesh/D017409>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Sufentanil" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/GGCSSNBKKAUURC-UHFFFAOYSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "An opioid analgesic that is used as an adjunct in anesthesia, in balanced anesthesia, and as a primary anesthetic agent." ;
    <https://schema.org/identifier> "D017409" .

<https://id.nlm.nih.gov/mesh/D017438>
    a <http://semanticscience.org/resource/SIO_010004> ;
