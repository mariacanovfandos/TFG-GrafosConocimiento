    <http://www.w3.org/2004/02/skos/core#definition> "A nucleoside consisting of the base guanine and the sugar deoxyribose." ;
    <https://schema.org/identifier> "D003849" .

<https://id.nlm.nih.gov/mesh/D003855>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Deoxyribose" ;
