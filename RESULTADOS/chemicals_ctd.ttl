    <http://www.w3.org/2004/02/skos/core#definition> "An essential amino acid that is required for the production of HISTAMINE." ;
    <https://schema.org/identifier> "D006639" .

<https://id.nlm.nih.gov/mesh/D006641>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Histidinol" ;
