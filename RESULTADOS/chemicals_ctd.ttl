    <https://schema.org/identifier> "D003855" .

<https://id.nlm.nih.gov/mesh/D003857>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Deoxyuridine" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/MXHRCPNRJAMMIM-SHYZEUOFSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "2'-Deoxyuridine. An antimetabolite that is converted to deoxyuridine triphosphate during DNA synthesis. Laboratory suppression of deoxyuridine is used to diagnose megaloblastic anemias due to vitamin B12 and folate deficiencies." ;
    <https://schema.org/identifier> "D003857" .

<https://id.nlm.nih.gov/mesh/D003868>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Dequalinium" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/PCSWXVJAIHCTMO-UHFFFAOYSA-P> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A topical bacteriostat that is available as various salts. It is used in wound dressings and mouth infections and may also have antifungal action, but may cause skin ulceration." ;
    <https://schema.org/identifier> "D003868" .

<https://id.nlm.nih.gov/mesh/D003891>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Desipramine" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/HCYAFALTSJYZDH-UHFFFAOYSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A tricyclic dibenzazepine compound that potentiates neurotransmission. Desipramine selectively blocks reuptake of norepinephrine from the neural synapse, and also appears to impair serotonin transport. This compound also possesses minor anticholinergic activity, through its affinity to muscarinic receptors." ;
    <https://schema.org/identifier> "D003891" .

<https://id.nlm.nih.gov/mesh/D003892>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Deslanoside" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/OBATZBGFDSVCJD-LALPQLPRSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Deacetyllanatoside C. A cardiotonic glycoside from the leaves of Digitalis lanata." ;
    <https://schema.org/identifier> "D003892" .

<https://id.nlm.nih.gov/mesh/D003894>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Deamino Arginine Vasopressin" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/NFLWUMRGJYTJIN-PNIOQBSNSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A synthetic analog of the pituitary hormone, ARGININE VASOPRESSIN. Its action is mediated by the VASOPRESSIN receptor V2. It has prolonged antidiuretic activity, but little pressor effects. It also modulates levels of circulating FACTOR VIII and VON WILLEBRAND FACTOR." ;
    <https://schema.org/identifier> "D003894" .

<https://id.nlm.nih.gov/mesh/D003897>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Desmosterol" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/AVSXSVCZWQODGV-DPAQBDIFSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "An intermediate in the synthesis of cholesterol." ;
    <https://schema.org/identifier> "D003897" .

<https://id.nlm.nih.gov/mesh/D003898>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Desonide" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/WBGKWQHBNHJJPZ-LECWWXJVSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A nonfluorinated corticosteroid anti-inflammatory agent used topically for DERMATOSES." ;
    <https://schema.org/identifier> "D003898" .

<https://id.nlm.nih.gov/mesh/D003899>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Desoximetasone" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/VWVSBHGCDBMOOT-IIEHVVJPSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A topical anti-inflammatory glucocorticoid used in DERMATOSES, skin allergies, PSORIASIS, etc." ;
    <https://schema.org/identifier> "D003899" .

<https://id.nlm.nih.gov/mesh/D003900>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Desoxycorticosterone" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/ZESRJSPZRDMNHY-YFWFAHHUSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A steroid metabolite that is the 11-deoxy derivative of CORTICOSTERONE and the 21-hydroxy derivative of PROGESTERONE" ;
    <https://schema.org/identifier> "D003900" .

<https://id.nlm.nih.gov/mesh/D003903>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Deuterium" ;
    <http://www.w3.org/2002/07/owl#sameAs> <https://identifiers.org/inchikey/UFHFLCQGNIYNRP-VVKOMZTBSA-N> ;
    <http://www.w3.org/2004/02/skos/core#definition> "The stable isotope of hydrogen. It has one neutron and one proton in the nucleus." ;
    <https://schema.org/identifier> "D003903" .

<https://id.nlm.nih.gov/mesh/D003907>
    a <http://semanticscience.org/resource/SIO_010004> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Dexamethasone" ;
